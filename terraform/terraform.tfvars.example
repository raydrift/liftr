# Copy this to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git — add it to .gitignore

subscription_id          = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
resource_group_name      = "liftr"
location                 = "eastus"
static_web_app_location = "eastus2"
app_name                 = "liftr"
storage_account_name     = "liftrstore" # Must be globally unique, 3-24 chars

# Generate a random secret: openssl rand -hex 32
api_secret_key = "your-random-secret-here"
